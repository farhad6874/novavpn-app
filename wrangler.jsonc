{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novavpn-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "8f19498e-569a-408d-91ac-8a75d51395c6","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1a7cf63b488246058873102e388288e0" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
